# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.

# HTTP port the dashboard listens on
PORT=3000

# `development` or `production`.
# In production, CORS is locked down to ALLOWED_ORIGIN.
NODE_ENV=development

# How often the server polls the upstream APIs, in milliseconds.
POLL_INTERVAL_MS=30000

# Maximum number of simultaneous WebSocket clients.
MAX_WS_CONNECTIONS=500

# Set to `true` only when running behind a reverse proxy (nginx, Cloudflare, ...)
# so that client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# Allowed browser origin when NODE_ENV=production, e.g. https://example.com
ALLOWED_ORIGIN=

# Google reCAPTCHA v2 keys (https://www.google.com/recaptcha/admin). The site key
# is rendered as a checkbox widget, so pick reCAPTCHA v2, not v3.
# Leave both empty to disable the captcha gate entirely; the server then logs a
# warning and skips verification.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=